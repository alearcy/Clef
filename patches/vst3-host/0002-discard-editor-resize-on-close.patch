+    #[test]
+    #[ignore = "requires the built TestSynth VST3 bundle"]
+    fn closing_editor_discards_pending_resize_requests() {
+        let path =
+            std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../test_plugins/TestSynth.vst3");
+        assert!(
+            path.exists(),
+            "build and bundle TestSynth before running this test"
+        );
+        let mut plugin = PluginImpl::load(&path).expect("load deterministic fixture");
+        *plugin.editor_resize.lock().unwrap() = Some((640, 480));
+        plugin.close_editor().expect("close detached editor");
+        assert_eq!(plugin.take_editor_resize_request(), None);
+        // A request from a subsequent editor must still be delivered.
+        *plugin.editor_resize.lock().unwrap() = Some((800, 600));
+        assert_eq!(plugin.take_editor_resize_request(), Some((800, 600)));
+    }
 
